# Whoop OAuth (from developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback

# Security
ENCRYPTION_SECRET=           # Used to derive AES-256 key via PBKDF2 for token encryption (min 32 chars)
ACCESS_PASSWORD=             # Browser password for connecting clients / linking WHOOP (min 12 chars, required)
MCP_BEARER_TOKEN=            # Optional static bearer token for direct MCP access (curl, scripts); leave blank to disable

# Server
PORT=3000
NODE_ENV=development
# Optional: public base URL used as the OAuth issuer (set to your deployed URL in prod, e.g. https://your-app.railway.app)
# PUBLIC_URL=

# Optional: extra CORS origins (comma-separated); localhost is always allowed
# CORS_ORIGINS=
# Optional: hostnames whose https redirect_uris may be registered by MCP clients.
# Comma-separated; when set it REPLACES the built-in defaults (claude.ai, claude.com,
# www.claude.ai, www.claude.com). localhost/127.0.0.1 are always allowed regardless.
# ALLOWED_REDIRECT_HOSTS=
# Optional: SQLite data directory (defaults to ./data)
# DATA_DIR=
