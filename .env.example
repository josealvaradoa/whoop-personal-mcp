# One owner must create their own app at https://developer.whoop.com/
# Requested scopes: read:recovery read:cycles read:sleep read:workout offline
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/auth/whoop/callback

# Required independent security values; never reuse account passwords.
# Generate: openssl rand -base64 48
ENCRYPTION_SECRET=
# Generate: openssl rand -base64 24
ACCESS_PASSWORD=

# Optional long-lived token for clients that cannot complete MCP OAuth.
# Leave empty to disable. Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# HTTP server
# /mcp automatically serves native 2026-07-28 and the stateless 2025-era
# fallback. There is no protocol-mode environment switch.
PORT=3000
# Safe local default. Container/cloud deployments must deliberately set 0.0.0.0.
BIND_HOST=127.0.0.1
NODE_ENV=development
# Exact external origin/OAuth issuer, without /mcp or a trailing slash. Keep it
# stable: MCP OAuth clients bind credentials and RFC 9207 `iss` to this issuer.
# Remote production deployments must use HTTPS and must also update the exact
# WHOOP_REDIRECT_URI registered in the WHOOP Developer Dashboard.
# PUBLIC_URL=https://whoop.example.com

# WHOOP request + response-body timeout in milliseconds (1000-120000).
# WHOOP_REQUEST_TIMEOUT_MS=30000

# Remote MCP OAuth callback hostnames are denied by default. Add only exact,
# verified HTTPS callback hostnames for trusted clients, comma-separated. This
# policy applies whether a client uses CIMD (preferred) or DCR (legacy fallback).
# Loopback localhost/127.0.0.1 remains allowed automatically.
# Example for Claude's documented current/future callbacks:
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Additional browser origins allowed on /mcp, as bare origins. PUBLIC_URL is
# included automatically; every other browser origin must be listed explicitly.
# CORS_ORIGINS=https://trusted-client.example

# Additional HTTP Host values accepted on /mcp. PUBLIC_URL's host is included
# automatically. Include a port when the incoming Host includes one.
# ALLOWED_HOSTS=internal-proxy.example:443

# Express proxy trust: false or an exact hop count from 1 to 10. Leave false for
# direct/local access. Set only to match a known reverse-proxy topology.
TRUST_PROXY=false

# SQLite authentication-state directory. Containers use /app/data.
DATA_DIR=./data

# Optional personal/event configuration source. Prefer an active
# whoop-mcp.config.json locally. In a secret-variable-only host, set one compact
# JSON object instead. Do not set WHOOP_MCP_CONFIG_JSON and CONFIG_PATH together.
# CONFIG_PATH=/app/whoop-mcp.config.json
# WHOOP_MCP_CONFIG_JSON={"athlete":{"sleep_target_hrs":null}}

# Targeted overrides for fields that affect current tool output.
# ATHLETE_TIMEZONE=America/New_York
# SLEEP_TARGET_HOURS=8
# EVENT_NAME=Target event
# EVENT_DATE=2030-12-31
# EVENT_PHASES_JSON=[{"name":"build","start":"2030-01-01","end":"2030-12-01"}]
# CONSECUTIVE_RED_ALERT=3
